# Resolved at runtime by `pass-cli run --env-file .env.proton-pass -- <command>` (see
# `npm run dev:netlify`). References the "(local) French Gas Stations Scrapper GitHub OAuth"
# item in the "Common" Proton Pass vault — no secret values live in this file, only pointers
# to it. Gitignored: these IDs are specific to this Proton Pass account.
GITHUB_CLIENT_ID=pass://[share-id-of-target-vault]/[item-id-in-target-vault]/Client ID
GITHUB_CLIENT_SECRET=pass://[share-id-of-target-vault]/[item-id-in-target-vault]/Client Secret
